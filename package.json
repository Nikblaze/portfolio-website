    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "prettier": "^3.6.0"
  },
  "overrides": {
    "brace-expansion@<1.1.21": "^1.1.21",
